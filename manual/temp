#0 Enter workspace

    cd ~/CARKit

#1 Start docker image

    ./docker/run_jetson.sh


#2 Start camera on cpu 0 and 1

    docker exec -it carkit bash
    taskset -c 0,1 ros2 run realsense2_camera realsense2_camera_node \
      --ros-args \
      -r __ns:=/camera \
      -r __node:=camera \
      -p enable_color:=true \
      -p enable_depth:=false \
      -p enable_infra:=false \
      -p enable_infra1:=false \
      -p enable_infra2:=false \
      -p enable_gyro:=false \
      -p enable_accel:=false \
      -p enable_motion:=false \
      -p enable_rgbd:=false \
      -p enable_sync:=false \
      -p align_depth.enable:=false \
      -p pointcloud.enable:=false \
      -p rgb_camera.color_profile:=640x480x15 \
      -p rgb_camera.color_format:=RGB8 \
      -p rgb_camera.global_time_enabled:=false

#3 Start joy control

    docker exec -it carkit bash
    taskset -c 2-5 ros2 launch carkit_human_control joystick.launch.py \
      vehicle_command_topic:=/ackermann_mux_unused

#4 Start control center

    docker exec -it carkit bash
    taskset -c 2-5 ros2 launch carkit_control_center control_center.launch.py

#5 Start Localization and Nav2

    docker exec -it carkit bash
    taskset -c 2-5 ros2 launch carkit_navigation navigation.launch.py \
  map:=/workspaces/CARKit/map/map_5fs.yaml \
  visualization:=foxglove

#6 Start YOLO

    docker exec -it carkit bash
    taskset -c 2-5 ros2 launch carkit_perception perception.launch.py \
      start_camera:=false \
      visualization:=none

#7 Start behavior center

    docker exec -it carkit bash
    taskset -c 2-5 ros2 launch carkit_behavior behavior_center.launch.py

#8 Start simple path planning and following

    docker exec -it carkit bash
    taskset -c 2-5 ros2 run carkit_amcl simple_loop_controller --ros-args \
  -p turn_radius:=1.0 \
  -p straight_distance:=2.0 \
  -p ackermann_topic:=/drive

