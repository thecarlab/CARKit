[Unit]
Description=CARKit Jetson WebUI and ROS 2 runtime
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=simple
User=@CARKIT_USER@
Group=@CARKIT_GROUP@
WorkingDirectory=@CARKIT_ROOT@
Environment=PULL_IMAGE=never
ExecStart=@CARKIT_ROOT@/docker/run_jetson.sh
ExecStop=-/usr/bin/docker stop --time 15 carkit
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
