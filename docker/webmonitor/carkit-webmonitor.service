[Unit]
Description=Report CARKit WebUI address to the CARLab fleet monitor
Wants=network-online.target
Requires=carkit.service
After=network-online.target carkit.service
PartOf=carkit.service

[Service]
Type=simple
EnvironmentFile=/etc/carkit-webmonitor.env
ExecStart=/usr/bin/python3 /usr/local/lib/carkit-webmonitor/report_ip.py
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=carkit.service
