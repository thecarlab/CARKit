<?xml version="1.0"?>
<!-- CARKit learning annotation: declares ROS metadata and dependencies for carkit_bringup. -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carkit_bringup</name>
  <version>0.1.0</version>
  <description>Hardware-neutral, course-profile-driven CARKit bringup.</description>
  <maintainer email="ada@udel.edu">CAR Lab</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>carkit_ada_academy</exec_depend>
  <exec_depend>carkit_control_center</exec_depend>
  <exec_depend>carkit_human_control</exec_depend>
  <exec_depend>carkit_amcl</exec_depend>
  <exec_depend>carkit_intro2av</exec_depend>
  <exec_depend>carkit_intro2av_cpp</exec_depend>
  <exec_depend>carkit_scan_filter</exec_depend>
  <exec_depend>carkit_web_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>carkit_vehicle_runtime</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- VESC messages and RealSense are optional, installed by the selected
       chassis adapter in docker/build_workspace.sh; OSRacer does not need them. -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
