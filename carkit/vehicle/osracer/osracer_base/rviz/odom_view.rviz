# CARKit learning annotation: documents runtime settings consumed by the surrounding package.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: odom
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        odom:
          base_footprint:
            {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Color: 25; 255; 0
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: false
      Enabled: true
      Keep: 100
      Name: Odometry
      Position Tolerance: 0.05
      Shape: Arrow
      Topic:
        Value: /odom
      Value: true
    - Class: rviz_default_plugins/Imu
      Acceleration properties:
        Alpha: 1
        Color: 255; 0; 0
        Scale: 0.2
        Value: true
      Axes properties:
        Alpha: 1
        Scale: 0.3
        Value: true
      Box properties:
        Alpha: 1
        Color: 255; 255; 255
        Scale: 0.1
        Value: true
      Enabled: true
      Name: IMU
      Topic:
        Value: /imu/data
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.785
      Target Frame: odom
      Yaw: 0.785
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1200
