<?xml version="1.0"?>
<!-- CARKit learning annotation: declares ROS metadata and dependencies for carkit_camera. -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carkit_camera</name>
  <version>0.1.0</version>
  <description>Latest-frame V4L2 camera publisher for low-latency CARKit perception.</description>
  <maintainer email="ada@udel.edu">CAR Lab</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>camera_info_manager</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <build_depend>libopencv-dev</build_depend>
  <exec_depend>libopencv-dev</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
